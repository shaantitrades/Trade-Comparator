# =======================================================
# VARIABLES D'ENVIRONNEMENT - Copier dans Coolify
# =======================================================

# --- POSTGRESQL (obligatoire) ---
# Format: postgresql://user:password@host:5432/dbname
# Dans Coolify : créer une DB PostgreSQL → copier l'Internal Connection URL
DATABASE_URL=postgresql://postgres:motdepasse@postgres:5432/tradecomparator

# --- ADMIN (obligatoire) ---
# Identifiants pour accéder à /admin
ADMIN_EMAIL=admin@trades.com
ADMIN_PASSWORD=admin0080

# --- GOOGLE ADSENSE (optionnel) ---
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=ca-pub-5343389597650456

# --- SITE (recommandé) ---
# URL publique de votre site sur le VPS
NEXT_PUBLIC_SITE_URL=https://votredomaine.com

# --- NODE ---
NODE_ENV=production
